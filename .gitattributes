# Line endings are normalized to LF in the repository *and* in every working
# tree, regardless of the contributor's core.autocrlf setting. Prettier writes
# LF, so without `eol=lf` a Windows checkout would produce CRLF files that the
# formatter immediately rewrites — churning diffs and breaking the husky hook.
* text=auto eol=lf

# Binary assets: never inspect, never convert.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary

# Generated by npm. Diffs are still viewable locally; this only collapses the
# file in GitHub pull requests and excludes it from language statistics.
package-lock.json linguist-generated=true
